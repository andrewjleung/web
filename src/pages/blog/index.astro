---
import { getCollection } from "astro:content";
import { compareDesc, formatDistanceToNowStrict } from "date-fns";
import { ArrowRight } from "lucide-react";
import Layout from "../../layouts/layout.astro";

const blogPosts = (await getCollection("blog"))
    .filter((post) => post.data.live)
    .sort(
        (a, b) =>
            compareDesc(a.data.publishDate, b.data.publishDate) ||
            a.data.title.localeCompare(b.data.title),
    )
    .map((post) => ({
        ...post,
        data: {
            ...post.data,
            formattedDate: formatDistanceToNowStrict(post.data.publishDate, {
                addSuffix: true,
            }),
        },
    }));
---

<Layout title="Andrew Leung – Blog" pageTitle="Blog" showHeader>
    <section class="flex flex-col gap-4 pt-4">
        {blogPosts.map(post => (
        <a
            href={`/blog/${post.id}`}
            class="group flex-row group ease-out duration-200 sm:hover:translate-x-2 border-t py-2"
        >
            <h3 class="">{post.data.title}</h3>

            <p class="pt-2 sm:pt-0.5 line-clamp-3 sm:line-clamp-none">
                {post.data.description}
            </p>
        </a>
        ))}
    </section>
</Layout>
