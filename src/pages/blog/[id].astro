---
import { getCollection, render } from "astro:content";
import { formatDistanceToNowStrict } from "date-fns";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts
        .filter((post) => post.data.live)
        .map((post) => ({
            params: { id: post.id },
            props: { post },
        }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = formatDistanceToNowStrict(post.data.publishDate, {
    addSuffix: true,
});
---

<Layout
    title={`Andrew Leung – Blog – ${post.data.title}`}
    description={post.data.description}
    pageTitle={post.data.title}
    showHeader
>
    <div class="font-normal text-muted-foreground text-sm -mt-4">
        {formattedDate}
    </div>

    <article class="prose-lg">
        <Content />
    </article>
</Layout>

<style>
</style>
