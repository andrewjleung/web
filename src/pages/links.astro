---
import clsx from "clsx";
import {
    VerticalSpotlightList,
    VerticalSpotlightListItem,
} from "../components/vertical-spotlight-list";
import Layout from "../layouts/Layout.astro";

type LinkItem = {
    name: string;
    detail?: string;
    href?: string;
};

const ITEMS: LinkItem[] = [
    {
        name: "Email",
        href: "mailto:andrewleung104@gmail.com",
    },
    {
        name: "GitHub",
        href: "https://github.com/andrewjleung",
    },
    {
        name: "LinkedIn",
        href: "https://linkedin.com/in/andrewjleung-",
    },
    {
        name: "Portfolio",
        href: "/",
    },
    {
        name: "Resume",
        href: "/resume",
    },
    {
        name: "Spotify",
        href: "https://open.spotify.com/artist/00zDjeTQDVOFlNttOnv9bc",
    },
    {
        name: "YouTube",
        href: "https://www.youtube.com/channel/UCVxaN-2GATE-3Ag9RTGrIXw",
    },
];
---

<Layout title="Andrew Leung – Links">
    <section id="links" class="">
        <VerticalSpotlightList numItems={ITEMS.length} client:load>
            {ITEMS.map(item =>(
                <VerticalSpotlightListItem className="group not-last:mb-0.5">
                    <a href={item.href} class="flex flex-col-reverse sm:flex-row sm:items-center">
                        <span
                            class={clsx(
                                "font-normal text-4xl tracking-tight duration-200 ease-out sm:group-hover:translate-x-2 whitespace-nowrap",
                                { "md:no-underline underline": item.href != undefined }
                            )}
                        >
                            {item.name}
                        </span>
                        {item.detail && <span
                            class="text-sm ml-auto text-muted-foreground sm:opacity-0 sm:group-hover:opacity-100 ease-in-out sm:ease-out duration-100 sm:duration-400 transition-all mr-2 whitespace-nowrap"
                        >
                            {item.detail}  
                        </span>} 
                    </a>
                </VerticalSpotlightListItem>
                ) )}
        </VerticalSpotlightList>
    </section>
</Layout>

<style>
</style>
